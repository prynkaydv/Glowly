# Google AI Studio API key. Keep this on the server; never put it in Flutter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# SerpApi Google Shopping API key (live offers, images and merchant links).
SERPAPI_API_KEY=
SERPAPI_GL=in
SERPAPI_HL=en
SERPAPI_CURRENCY=INR

# Protect the admin dashboard and API. Change both before deployment.
ADMIN_PASSWORD=change-this-admin-password
ADMIN_KEY=change-this-long-random-admin-key
DATABASE_PATH=./glowly.db
